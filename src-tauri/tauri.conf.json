{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fedit",
  "mainBinaryName": "fedit",
  "version": "../package.json",
  "identifier": "com.fingerskier.fedit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fedit",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 300,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
